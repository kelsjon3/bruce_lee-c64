{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter": {
      "models": {
        "poolside/laguna-s-2.1:free": {
          "name": "Laguna S 2.1 (free)"
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 24000
    },
    "buffer": 16000
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git reset --hard*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git clean*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "pacman *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "yay *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "paru *",
      "effect": "deny"
    }
  ]
}
